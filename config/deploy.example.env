# Copy to config/deploy.local.env (gitignored) to choose how tradility runs. Nothing here is required: without it,
# deploy/deploy.sh uses "dev". See docs/deployment.md.
#
#   dev   one run in the foreground, no systemd, no cluster
#   host  the systemd user timer
#   k3s   a CronJob in K3s, created suspended and started only after verification
TRADILITY_DEPLOY_MODE=dev
