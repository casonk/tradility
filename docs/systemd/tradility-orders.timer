[Unit]
Description=Refresh Tradility broker orders every five minutes (extended hours on weekdays, hourly otherwise)

[Timer]
# Orders fill from 04:00 to 20:00 Eastern on weekdays; crypto trades around the clock.
OnCalendar=Mon..Fri *-*-* 04..19:00/5:00
OnCalendar=*-*-* *:07:00
Persistent=true
Unit=tradility-orders.service
AccuracySec=30s

[Install]
WantedBy=timers.target
